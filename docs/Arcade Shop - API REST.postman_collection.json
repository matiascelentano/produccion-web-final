		{
			"name": "GET /login (obtener CSRF token)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
							"if (xsrfCookie) {",
							"    pm.environment.set('csrf_token', decodeURIComponent(xsrfCookie));",
							"    console.log('CSRF token saved:', decodeURIComponent(xsrfCookie));",
							"} else {",
							"    console.warn('XSRF-TOKEN cookie not found in response.');",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"login"
					]
				},
				"description": "Primer paso del flujo de login. Laravel devuelve la cookie XSRF-TOKEN en esta respuesta. El script post-respuesta la guarda en la variable de entorno 'csrf_token' para que POST /login pueda usarla en el header X-XSRF-TOKEN."
			},
			"response": []
		},
		{
			"name": "POST /login (iniciar sesion para probar /api/orders)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Login exitoso o redirige correctamente (200, 302)', function () {",
							"    // Laravel may redirect (302) or return 200 depending on configuration.",
							"    // A 419 means CSRF token mismatch — run GET /login first to populate the cookie jar.",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// CSRF token is set by the GET /login request that must run before this one.",
							"// If csrf_token is missing, run GET /login (obtener CSRF token) first.",
							"const token = pm.environment.get('csrf_token');",
							"if (!token) {",
							"    throw new Error('csrf_token is not set. Run \"GET /login (obtener CSRF token)\" first.');",
							"}",
							"console.log('Using CSRF token:', token);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/x-www-form-urlencoded"
					},
					{
						"key": "X-XSRF-TOKEN",
						"value": "{{csrf_token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "email",
							"value": "test@example.com",
							"type": "text"
						},
						{
							"key": "password",
							"value": "password",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"login"
					]
				},
				"description": "Postman guarda la cookie de sesión automáticamente (con 'Cookie jar' activado en el entorno). Correr este request antes del siguiente para autenticarse antes de pedir /api/orders."
			},
			"response": []
		},
